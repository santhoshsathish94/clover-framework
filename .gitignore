# Source artwork kept locally. The web-ready copy lives in site/assets/.
assets/peacock-feather.png

__pycache__/
.pytest_cache/

# The working context file stays on the machine doing the work. It records where the framework is
# weak and what has not been verified, which is useful to whoever is working and useful to nobody else.
CLOVER-CONTEXT.md

# Written by reference/runtime-enforcement/verify.sh when the example runs.
reference/runtime-enforcement/workspace/src/agent-change.js

# Keep reproducibility sources/reports/fixtures in Git, but not compiled artifacts.
research/k3/experiments/*.tar.gz
research/k3/experiments/reverse-integration/deps/
research/k3/experiments/**/candidate
research/k3/experiments/**/reference
research/k3/experiments/**/prior-candidate
research/k3/experiments/**/seed-prior-candidate
research/k3/experiments/**/seed-reader-test
research/k3/experiments/**/seed.bin
research/k3/experiments/**/fruit.bin

# Generated from clover-one by scripts/build-ai-site.mjs before Pages validation.
site/ai/

# clover-intelegence: the mappings describe where every dataset piece lives, so they
# stay in Git. The bytes themselves live on the hosts and are not reproducible from here.
clover-intelegence/**/*.bin
clover-intelegence/**/*.model
clover-intelegence/**/*.safetensors
clover-intelegence/**/*.direct
clover-intelegence/**/*.npy
clover-intelegence/**/*.pt

# Each distributed node carried its own full copy of the dataset tree. One copy of the
# structure is kept under clover-intelegence/dataset/; the per-node duplicates are not.
clover-intelegence/code/**/bin/dataset/**
!clover-intelegence/code/**/bin/dataset/.gitkeep

# Build output and run scratch.
clover-intelegence/**/__pycache__/
clover-intelegence/**/*.known-good
clover-intelegence/code/**/bin/*.err
clover-intelegence/code/**/bin/*.log
