=== 1. Read & Run vukrosic/rosenblatt-from-scratch in a work copy ===
--- FILE: perc.py ---
"""The perceptron and the pictures it looks at. Plain Python, nothing to install."""
import random

SIDE = 20            # the Mark I looked through 20 by 20 photocells
N = SIDE * SIDE      # 400 squares


def fire(w, b, x):
    """One model nerve cell. Every input votes with its weight. Answer 1 if the votes add up above zero."""
    return 1 if sum(wi * xi for wi, xi in zip(w, x)) + b > 0 else 0


def lit(x):
    """The squares that are on. A dark square votes with zero, so only these matter."""
    return [i for i, v in enumerate(x) if v]


def fire_lit(w, b, on):
    s = b
    for i in on:
        s += w[i]
    return 1 if s > 0 else 0


def teach(w, b, on, want):
    """Rosenblatt's rule. Right answer: change nothing.
    Wrong answer: add the input to the weights (if it should have said yes) or take it away (if no).
    Returns the new bias and 1 if this was a mistake."""
    if fire_lit(w, b, on) == want:
        return b, 0
    step = 1 if want == 1 else -1
    for i in on:
        w[i] += step
    return b + step, 1


# ---- pictures on the 20 by 20 retina ----

def blank():
    return [0] * N


def card(rng):
    """A punch card with one 4 by 4 mark, on the left half or on the right half. Returns (picture, side); side 1 = right."""
    side = rng.randrange(2)
    col = rng.randrange(0, 7) + (10 if side else 0)
    row = rng.randrange(0, 17)
    x = blank()
    for r in range(row, row + 4):
        for c in range(col, col + 4):
            x[r * SIDE + c] = 1
    return x, side


G = 12  # letters are drawn 12 by 12


def _glyph(name):
    g = [[0] * G for _ in range(G)]
    for i in range(G):
        for j in range(G):
            if name == 'X':
                on = abs(i - j) <= 1 or abs(i + j - (G - 1)) <= 1
            elif name == 'E':
                on = j <= 1 or (i <= 1 or i >= G - 2 or i in (5, 6)) and j <= G - 2
            elif name == 'T':
                on = i <= 1 or j in (5, 6)
            else:  # 'O'
                on = (i <= 1 or i >= G - 2 or j <= 1 or j >= G - 1 - 1) and not ((i in (0, G - 1)) and (j in (0, G - 1)))
            g[i][j] = 1 if on else 0
    return g


LETTERS = ['X', 'E', 'T', 'O']
GLYPH = {name: _glyph(name) for name in LETTERS}


def letter(name, rng, noise=6):
    """The letter at a random place on the retina, with a few squares flipped."""
    dy, dx = rng.randrange(0, SIDE - G + 1), rng.randrange(0, SIDE - G + 1)
    x = blank()
    g = GLYPH[name]
    for i in range(G):
        for j in range(G):
            if g[i][j]:
                x[(i + dy) * SIDE + j + dx] = 1
    for i in rng.sample(range(N), noise):
        x[i] = 1 - x[i]
    return x


def letter_set(seed, count):
    """`count` letters in mixed order, as (picture, number of the letter)."""
    rng = random.Random(seed)
    out = [(letter(LETTERS[k % len(LETTERS)], rng), k % len(LETTERS)) for k in range(count)]
    rng.shuffle(out)
    return out


def show(x, side=SIDE):
    return '\n'.join(''.join('#' if x[r * side + c] else '.' for c in range(side)) for r in range(side))

--- FILE: step1_neuron.py ---
"""Step 1. The model nerve cell of 1943: inputs vote, each with a weight, and the cell answers yes above a threshold.
Here every weight is set by hand. Nothing learns yet."""
import random
from perc import N, SIDE, fire, card, lit, fire_lit
from save import save

# Take an umbrella? Three yes/no facts vote. The weights say how much each fact counts.
FACTS = ['dark clouds', 'forecast says rain', 'going by car']
W, B = [2, 3, -4], -2   # answer yes if 2*clouds + 3*forecast - 4*car is above 2
print('Take an umbrella?  weights: clouds +2, forecast +3, car -4. Yes if the sum is above 2.')
umbrella = []
for n in range(8):
    x = [(n >> 2) & 1, (n >> 1) & 1, n & 1]
    total = sum(w * v for w, v in zip(W, x))
    yes = fire(W, B, x)
    umbrella.append({'x': x, 'sum': total, 'yes': yes})
    print('   clouds %d  forecast %d  car %d   sum %2d   %s' % (x[0], x[1], x[2], total, 'yes' if yes else 'no'))

# Two switches and a lamp. Each rule is one cell with hand-set weights.
RULES = {'both (AND)': ([1, 1], -1), 'at least one (OR)': ([1, 1], 0), 'not the first (NOT)': ([-1, 0], 1)}
tables = {}
for name, (w, b) in RULES.items():
    out = [fire(w, b, [p, q]) for p in (0, 1) for q in (0, 1)]
    tables[name] = {'w': w, 'b': b, 'out': out}
    print('%-20s weights %s, bias %2d   answers for 00 01 10 11: %s' % (name, w, b, ' '.join(map(str, out))))

# A card with a mark on the left or on the right. By hand: -1 on the 200 left squares, +1 on the 200 right squares.
hand = [1 if i % SIDE >= SIDE // 2 else -1 for i in range(N)]
rng = random.Random(1)
right = 0
for _ in range(1000):
    x, side = card(rng)
    right += fire_lit(hand, 0, lit(x)) == side
print('Left or right mark, %d weights set by hand: %d of 1,000 cards right.' % (N, right))
print('That took %d numbers, and we knew the answer in advance. For the letter X against the letter E, nobody knows the %d numbers.' % (N, N))

save(1, umbrella=umbrella, facts=FACTS, w=W, b=B, tables=tables, hand_right=right, n=N)

--- FILE: step2_learn.py ---
"""Step 2. The 1958 demonstration, rebuilt. Cards marked on the left or on the right go in one at a time.
All 400 weights start at zero. The machine guesses, is told the answer, and changes its weights only when it was wrong."""
import random
from perc import N, SIDE, card, lit, fire_lit, teach, show
from save import save

rng = random.Random(1958)
test_rng = random.Random(7)
TEST = [(lit(x), side) for x, side in (card(test_rng) for _ in range(2000))]


def score(w, b):
    return sum(fire_lit(w, b, on) == side for on, side in TEST)


w, b = [0] * N, 0
mistakes, first, marks, snaps = [], [], {}, {}
CHECK = [0, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000]
marks[0] = score(w, b)
snaps[0] = w[:]
for t in range(1, 10001):
    x, side = card(rng)
    on = lit(x)
    guess = fire_lit(w, b, on)
    b, miss = teach(w, b, on, side)
    if miss:
        mistakes.append(t)
    if t <= 12:
        first.append({'t': t, 'col': on[0] % SIDE, 'row': on[0] // SIDE, 'side': side, 'guess': guess, 'miss': miss})
    if t in CHECK:
        marks[t] = score(w, b)
        snaps[t] = w[:]

print('Cards one at a time. Left = 0, right = 1. All %d weights start at zero.' % N)
for f in first:
    print('   card %2d: mark on the %-5s  guess %-5s  %s' % (f['t'], 'right' if f['side'] else 'left',
                                                           'right' if f['guess'] else 'left', 'WRONG, weights change' if f['miss'] else 'right'))
print('2,000 fresh cards, how many it gets right:')
for t in CHECK:
    print('   after %4d cards: %4d of 2,000' % (t, marks[t]))
in50 = sum(1 for m in mistakes if m <= 50)
print('Mistakes in the first 50 cards: %d. In all 10,000 cards: %d. The last mistake was on card %d.' % (in50, len(mistakes), mistakes[-1]))
print('The weights after 10,000 cards, by column (sum of the 20 squares in each column):')
cols = [sum(w[r * SIDE + c] for r in range(SIDE)) for c in range(SIDE)]
print('   ' + ' '.join('%d' % c for c in cols))
print('   left half: %d of 200 weights below zero. right half: %d of 200 above zero.' % (
    sum(1 for i in range(N) if i % SIDE < 10 and w[i] < 0), sum(1 for i in range(N) if i % SIDE >= 10 and w[i] > 0)))

save(2, first=first, marks=[[t, marks[t]] for t in CHECK], mistakes=mistakes, in50=in50, last=mistakes[-1],
     snaps=[[t, snaps[t]] for t in CHECK], final=w, bias=b, cols=cols)

--- FILE: step3_mark1.py ---
"""Step 3. The Mark I Perceptron of 1960, rebuilt in numbers: 400 photocells, 512 middle units wired at random,
and response units whose weights are the only thing that learns. Task: name the letter (X, E, T or O), wherever it sits."""
import random
from perc import N, LETTERS, letter_set, show
from save import save

A_UNITS = 512
PLUS, MINUS, THRESHOLD = 10, 10, 2   # our choice: each middle unit has 10 "yes" wires and 10 "no" wires to random photocells

wire_rng = random.Random(1960)
WIRES = []
for _ in range(A_UNITS):
    cells = wire_rng.sample(range(N), PLUS + MINUS)
    WIRES.append((cells[:PLUS], cells[PLUS:]))


def middle(x):
    """Which of the 512 middle units fire for this picture. Their wires never change."""
    on = []
    for a, (plus, minus) in enumerate(WIRES):
        if sum(x[i] for i in plus) - sum(x[i] for i in minus) >= THRESHOLD:
            on.append(a)
    return on


train = [(middle(x), k, x) for x, k in letter_set(3, 2000)]
test = [(middle(x), k, x) for x, k in letter_set(4, 1000)]

# One response unit per letter. Each has 512 knobs (weights), all at zero.
W = [[0] * A_UNITS for _ in LETTERS]
B = [0] * len(LETTERS)


def sums(on):
    return [B[r] + sum(W[r][a] for a in on) for r in range(len(LETTERS))]


def answer(on):
    s = sums(on)
    return s.index(max(s))


def right(data):
    return sum(answer(on) == want for on, want, _ in data)


turns, history = 0, [[0, right(test)]]
seen = 0
for sweep in range(1, 11):
    wrong = 0
    for on, want, _ in train:
        seen += 1
        s = sums(on)
        for r in range(len(LETTERS)):
            yes = 1 if s[r] > 0 else 0
            target = 1 if r == want else 0
            if yes != target:           # the same rule as step 2, once per response unit
                step = 1 if target else -1
                for a in on:
                    W[r][a] += step
                B[r] += step
                turns += len(on)
                wrong += 1
        if seen in (50, 100, 200, 500, 1000):
            history.append([seen, right(test)])
    history.append([seen, right(test)])
    print('pass %d through the 2,000 training letters: %3d corrections; 1,000 new letters: %d right' % (sweep, wrong, right(test)))
    if wrong == 0:
        break

firing = sum(len(on) for on, _, _ in test) / len(test)
per = [[sum(1 for on, want, _ in test if want == k and answer(on) == k), sum(1 for _, want, _ in test if want == k)] for k in range(len(LETTERS))]
print('Photocells %d, middle units %d (each with %d random wires), response units used %d, knobs %d.' % (N, A_UNITS, PLUS + MINUS, len(LETTERS), A_UNITS * len(LETTERS)))
print('On average %.0f of the %d middle units fire for a letter.' % (firing, A_UNITS))
print('Knob turns in training: %s.' % format(turns, ','))
print('New letters right: %d of 1,000  (%s)' % (right(test), ', '.join('%s %d of %d' % (LETTERS[k], per[k][0], per[k][1]) for k in range(len(LETTERS)))))
print('Before any training: %d of 1,000.' % history[0][1])
ex = [{'name': LETTERS[want], 'x': x, 'on': on, 'got': LETTERS[answer(on)]} for on, want, x in test[:8]]
print(show(ex[0]['x']))

save(3, a_units=A_UNITS, wires=PLUS + MINUS, plus=PLUS, minus=MINUS, threshold=THRESHOLD, wiring=[[p, m] for p, m in WIRES[:40]],
     history=history, turns=turns, right=right(test), per=per, firing=firing, examples=ex, knobs=A_UNITS * len(LETTERS), letters=LETTERS)

--- FILE: step4_converge.py ---
"""Step 4. The guarantee. If one straight line can split the two groups, the rule finds such a line,
and the number of mistakes on the way has a ceiling: (R / gap)^2. We test it on 1,000 made-up problems.
Whole numbers only, so every Python prints the same."""
import random
from save import save

SIZE = 50      # points lie on a grid from -50 to 50
ONE = 50       # the constant third input (lets the line sit away from the centre)


def problem(rng, gap, count=40):
    """Points on a grid, split by a hidden line a*x + b*y + c = 0, with nothing closer to the line than `gap`."""
    while True:
        a, b = rng.randrange(-9, 10), rng.randrange(-9, 10)
        if a or b:
            break
    c = rng.randrange(-150, 151)
    norm = (a * a + b * b) ** 0.5
    pts = []
    while len(pts) < count:
        x, y = rng.randrange(-SIZE, SIZE + 1), rng.randrange(-SIZE, SIZE + 1)
        d = a * x + b * y + c
        if abs(d) / norm >= gap:
            pts.append((x, y, 1 if d > 0 else 0))
    if len({p[2] for p in pts}) < 2:
        return problem(rng, gap, count)
    return pts, (a, b, c)


def ceiling(pts, line):
    """(R / gap)^2 for this problem, measured with the hidden line (all three inputs counted)."""
    a, b, c = line
    k = c / ONE
    norm = (a * a + b * b + k * k) ** 0.5
    margin = min(abs(a * x + b * y + c) for x, y, _ in pts) / norm
    r2 = max(x * x + y * y + ONE * ONE for x, y, _ in pts)
    return r2 / (margin * margin)


def learn(pts, rng, trace=False):
    """Rosenblatt's rule on points. Returns the mistakes, and the line after each mistake if asked."""
    w = [0, 0, 0]
    order = list(range(len(pts)))
    mistakes, lines = 0, []
    while True:
        rng.shuffle(order)
        clean = True
        for i in order:
            x, y, want = pts[i]
            got = 1 if w[0] * x + w[1] * y + w[2] * ONE > 0 else 0
            if got != want:
                s = 1 if want else -1
                w[0] += s * x
                w[1] += s * y
                w[2] += s * ONE
                mistakes += 1
                clean = False
                if trace:
                    lines.append({'w': w[:], 'i': i})
        if clean:
            return mistakes, lines, w


rng = random.Random(1962)
rows = []
total = 0
worst_share = 0.0
print('gap    problems   mistakes: fewest  average  most    ceiling on average')
for gap in (20, 10, 5, 2, 1):
    ms, cs = [], []
    for _ in range(200):
        pts, line = problem(rng, gap)
        m, _, _ = learn(pts, rng)
        c = ceiling(pts, line)
        assert m <= c
        worst_share = max(worst_share, m / c)
        ms.append(m)
        cs.append(c)
    total += len(ms)
    rows.append({'gap': gap, 'low': min(ms), 'avg': sum(ms) / len(ms), 'high': max(ms), 'ceiling': sum(cs) / len(cs)})
    print('%3d      %4d          %6d  %7.1f  %5d    %12s' % (gap, len(ms), min(ms), sum(ms) / len(ms), max(ms), format(round(sum(cs) / len(cs)), ',')))
print('%s problems. The rule stopped on every one. Closest it came to its ceiling: %.0f%% of it.' % (format(total, ','), 100 * worst_share))

# One problem to draw: the line after every mistake.
rng = random.Random(8)
while True:
    pts, line = problem(rng, 6, 30)
    m, lines, w = learn(pts, random.Random(1), trace=True)
    if 7 <= m <= 10:
        break
print('The drawn example: 30 points, gap 6, %d mistakes, ceiling %s.' % (m, format(round(ceiling(pts, line)), ',')))

save(4, rows=rows, total=total, worst=worst_share, example={'pts': pts, 'line': line, 'steps': lines, 'final': w, 'mistakes': m, 'ceiling': ceiling(pts, line)}, one=ONE, size=SIZE)

--- FILE: step5_xor.py ---
"""Step 5. The puzzle of 1969. A stairway lamp has a switch at the bottom and one at the top.
The lamp is on when exactly one switch is up. One cell with two inputs cannot learn that rule.
Then the larger version from the book: is the number of lit squares odd?"""
import random
from itertools import combinations
from operator import mul
from perc import fire
from save import save

CASES = [(0, 0), (0, 1), (1, 0), (1, 1)]
LAMP = [0, 1, 1, 0]       # on when exactly one switch is up

# 1. Rosenblatt's rule, a million cards.
rng = random.Random(1969)
w, b = [0, 0], 0
best, seen, changes = 0, set(), 0
for t in range(1000000):
    k = rng.randrange(4)
    x, want = CASES[k], LAMP[k]
    got = fire(w, b, x)
    if got != want:
        s = 1 if want else -1
        w[0] += s * x[0]
        w[1] += s * x[1]
        b += s
        changes += 1
    seen.add((w[0], w[1], b))
    best = max(best, sum(fire(w, b, c) == l for c, l in zip(CASES, LAMP)))
print('The stairway lamp, 1,000,000 cards: the weights changed %s times and never settled.' % format(changes, ','))
print('   most cases right at any moment: %d of 4. Different settings of the three numbers it visited: %d.' % (best, len(seen)))

# 2. Every cell with whole-number weights from -10 to 10: which of the 16 two-switch rules can a cell do?
rules = {}
tried = 0
for w0 in range(-10, 11):
    for w1 in range(-10, 11):
        for bias in range(-10, 11):
            tried += 1
            out = tuple(fire([w0, w1], bias, c) for c in CASES)
            rules[out] = rules.get(out, 0) + 1
missing = [r for r in ([(n >> 3) & 1, (n >> 2) & 1, (n >> 1) & 1, n & 1] for n in range(16)) if tuple(r) not in rules]
print('%s cells tried. Of the 16 possible rules for two switches, a single cell can do %d.' % (format(tried, ','), len(rules)))
print('   the missing ones (answers for 00 01 10 11): %s' % '  '.join(' '.join(map(str, m)) for m in missing))
print('   cells that do AND: %d, OR: %d, the stairway lamp: %d' % (rules[(0, 0, 0, 1)], rules[(0, 1, 1, 1)], rules.get((0, 1, 1, 0), 0)))

# 3. Odd or even? A 3 by 3 retina, all 512 pictures. The machine gets every middle unit that looks at up to k squares.
#    (A unit that looks at a set of squares is written here as the product of those squares, with dark = -1, lit = +1.
#     Any rule on up to k squares is a sum of such products, so this is the strongest machine of that kind.)
SQ = 9
PICS = [[1 if (n >> i) & 1 else -1 for i in range(SQ)] for n in range(1 << SQ)]
ODD = [1 if bin(n).count('1') % 2 else -1 for n in range(1 << SQ)]
parity = []
print('Odd or even number of lit squares, 9 squares, 512 pictures, 300 passes each:')
print('   a unit may look at    middle units    best the machine reached')
for k in range(1, SQ + 1):
    sets = [s for size in range(0, k + 1) for s in combinations(range(SQ), size)]
    feats = []
    for p in PICS:
        row = []
        for s in sets:
            v = 1
            for i in s:
                v *= p[i]
            row.append(v)
        feats.append(row)
    wk = [0] * len(sets)
    top = 0
    order = list(range(len(PICS)))
    prng = random.Random(k)
    for sweep in range(300):
        prng.shuffle(order)
        for i in order:
            f = feats[i]
            if (1 if sum(map(mul, wk, f)) > 0 else -1) != ODD[i]:
                for j, v in enumerate(f):
                    wk[j] += ODD[i] * v
        ok = sum((1 if sum(map(mul, wk, f)) > 0 else -1) == o for f, o in zip(feats, ODD))
        top = max(top, ok)
        if ok == len(PICS):
            break
    parity.append({'k': k, 'units': len(sets), 'best': top, 'sweeps': sweep + 1})
    print('   %d square%s            %4d            %3d of 512%s' % (k, ' ' if k == 1 else 's', len(sets), top, '   (after %d passes)' % (sweep + 1) if top == 512 else ''))

save(5, changes=changes, best=best, visited=len(seen), tried=tried, can=len(rules), missing=missing,
     counts={'and': rules[(0, 0, 0, 1)], 'or': rules[(0, 1, 1, 1)], 'xor': rules.get((0, 1, 1, 0), 0)}, parity=parity)

--- FILE: tests.py ---
"""Checks. run_all.sh runs them last, on the numbers the seven steps saved in runs/, and on the cell itself."""
import json
import os
import random
from perc import N, SIDE, LETTERS, fire, fire_lit, teach, card, lit, letter_set

HERE = os.path.dirname(os.path.abspath(__file__))
r = {i: json.load(open(os.path.join(HERE, 'runs', 'step%d.json' % i))) for i in range(1, 8)}

# the cell: a weighted vote against zero; the two ways of asking it agree
rng = random.Random(0)
for _ in range(200):
    w = [rng.randint(-3, 3) for _ in range(N)]
    x, _ = card(rng)
    assert fire(w, 1, x) == fire_lit(w, 1, lit(x))
# the rule: a right answer changes nothing, a wrong answer moves only the lit squares, by one
w = [0] * N
x, side = card(random.Random(5))
on = lit(x)
b, miss = teach(w, 0, on, 1)
assert miss == 1 and b == 1 and sum(w) == len(on) == 16 and all(w[i] == 1 for i in on)
before = w[:]
assert teach(w, b, on, 1) == (b, 0) and w == before
# the letter sets: a quarter each, and the test letters are not the training letters
train, test = letter_set(3, 2000), letter_set(4, 1000)
assert [sum(1 for _, k in test if k == j) for j in range(4)] == [250] * 4 and len(LETTERS) == 4
assert not {tuple(x) for x, _ in test} & {tuple(x) for x, _ in train}

# 1. the umbrella cell says yes in 2 of 8 cases; the hand-set weights sort every card
assert sum(u['yes'] for u in r[1]['umbrella']) == 2 and r[1]['hand_right'] == 1000
assert r[1]['tables']['both (AND)']['out'] == [0, 0, 0, 1] and r[1]['tables']['at least one (OR)']['out'] == [0, 1, 1, 1]

# 2. learning from mistakes: from a coin flip to every fresh card right, and the mistakes stop
marks = dict(r[2]['marks'])
assert marks[0] < 1100 and marks[50] > 1900 and marks[1000] == 2000
assert r[2]['in50'] == sum(1 for m in r[2]['mistakes'] if m <= 50) and r[2]['last'] == r[2]['mistakes'][-1] < 1000
assert sum(r[2]['cols'][:10]) < 0 < sum(r[2]['cols'][10:]) and len(r[2]['final']) == N and SIDE == 20

# 3. the Mark I: 512 fixed random middle units, 2,048 knobs, far above chance on letters it never saw
assert r[3]['a_units'] == 512 and r[3]['knobs'] == 2048 and r[3]['history'][0][1] <= 300 and r[3]['right'] > 950
assert sum(p[0] for p in r[3]['per']) == r[3]['right'] and all(p[1] == 250 for p in r[3]['per'])

# 4. the guarantee: it stopped on all 1,000 problems, and never passed the ceiling
assert r[4]['total'] == 1000 and r[4]['worst'] <= 1
assert all(row['high'] <= row['ceiling'] for row in r[4]['rows']) and r[4]['example']['mistakes'] <= r[4]['example']['ceiling']
avgs = [row['avg'] for row in r[4]['rows']]
assert avgs == sorted(avgs)                      # a narrower gap costs more mistakes

# 5. the stairway lamp: no cell does it, the rule never settles; 14 of the 16 two-switch rules are possible
assert r[5]['best'] == 3 and r[5]['counts']['xor'] == 0 and r[5]['can'] == 14
assert sorted(r[5]['missing']) == [[0, 1, 1, 0], [1, 0, 0, 1]] and r[5]['changes'] > 100000
par = {p['k']: p for p in r[5]['parity']}
assert par[9]['best'] == 512 and par[9]['units'] == 512 and par[8]['best'] < 512 and par[1]['best'] < 400

# 6. three cells by hand do the lamp; random middle cells need about one cell per case
assert [h['out'] for h in r[6]['hand']] == [0, 1, 1, 0]
need = {x['n']: x['cells'] for x in r[6]['need']}
assert need[2] <= 32 and need[8] >= 128 and all(need[n] <= need[n + 1] for n in range(2, 8))

# 7. blame passed backward: the middle cells learn, and a few of them beat 512 random ones
assert r[7]['lamp_solved'] > 50 and r[7]['lamp4'] == 100
assert all(o['solved'] >= 5 and o['cells'] < o['random'] for o in r[7]['odd'])
assert all(x['right'] > r[7]['mark1'] and x['cells'] < 512 for x in r[7]['letters'])
last = r[7]['trace'][-1]['outs']
assert last[0] < 0.5 < last[1] and last[3] < 0.5 < last[2]

print('All checks passed.')


