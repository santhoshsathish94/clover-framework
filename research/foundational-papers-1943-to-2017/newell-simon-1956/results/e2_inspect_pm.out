=== run_logic.py ===
# Python 3

#
# Test logic.py by successively trying to deduce theorem #(i + 1) in
# _Principia_Mathematica_, *2, given theorems #1, ..., #i.
#

# David Moews, Feb. 2026.  Released into the public domain, CC0.

import argparse
import subprocess
import os
import sys

def run_test(exprn, interp, source_file, do_trace):
    if interp is None:
        interp = 'logic.py'
    the_args = ['python3', interp, '--info', '--prove', exprn]
    if source_file is not None:
        the_args.extend(['--source', source_file])
    if do_trace:
        the_args.extend(['--trace'])
    rv = subprocess.run(args = the_args)
    sys.stdout.flush()
    sys.stderr.flush()
    print()
    print()

argparser = argparse.ArgumentParser(epilog='''
Run logic.py or some other program successively to try to prove each of the
theorems in pm-theorems.txt, allowing it to use, for each theorem, all of the
previous theorems in pm-theorems.txt, as well as the axioms in pm-axioms.txt.
''')
argparser.add_argument('--interp',
          help = 'interpreter for source code (default: logic.py)')
argparser.add_argument('--source',
          help = 'input file for source code (default: logic-routines.txt)')
argparser.add_argument('--trace', action = 'store_true',
          help = 'Print out all instructions executed (very verbose)')

args = argparser.parse_args()

f = open('pm-axioms.txt', 'r')
axioms = [l.strip() for l in f.readlines() if l[ : 1] != '#']
f.close()

tr_table = {ord('p') : 'A', ord('q') : 'B', ord('r') : 'C', ord('s') : 'D'}

theorems = []
f = open('pm-theorems.txt', 'r')
for l in f.readlines():
    l = l.strip()
    if l[ : 1] == '#':
        print(l)
        continue
    g = open('theorem-list.txt', 'w')
    theorem_list = '\n'.join(axioms + theorems).translate(tr_table)
    g.write(theorem_list)
    g.write('\n')
    g.close()
    sys.stdout.flush()
    run_test(l, args.interp, args.source, args.trace)
    theorems.append(l)
f.close()
