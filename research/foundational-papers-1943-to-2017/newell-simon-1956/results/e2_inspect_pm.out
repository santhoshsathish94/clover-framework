=== pm-axioms.txt ===
#
# Axioms from _Principia_Mathematica_, *1
#
# *1.2, Taut
( ( p \/ p ) -> p )
# *1.3, Add
( q -> ( p \/ q ) )
# *1.4, Perm
( ( p \/ q ) -> ( q \/ p ) )
# *1.5, Assoc
( ( p \/ ( q \/ r ) ) -> ( q \/ ( p \/ r ) ) )
# *1.6, Sum
( ( q -> r ) -> ( ( p \/ q ) -> ( p \/ r ) ) )
