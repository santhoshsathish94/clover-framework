# The only file in this folder that names a location. Everything else - the
# scripts, the two generators and the program - takes its paths from here.
#
# Each line yields to an already-set environment variable, so a one-off run can
# override any of them without editing this file:
#
#   K3_MODEL=/mnt/other/k3model ./build.sh
#
# Sourced by build.sh, gate.sh and ab.sh.

# The Kimi K3 checkpoint: the directory holding the *.safetensors shards.
: "${K3_MODEL:=/root/k3model}"

# The packed trunk, holding trunk.bin and trunk.json. Built by the engine
# (kimi-k3-in-c tools/pack_trunk.py and tools/int8_trunk.py), not by anything here.
: "${K3_TRUNK:=/root/k3trunk_i8}"

# Which copy of the trunk to read. Pointing this at tmpfs removes the load
# cost entirely: process total drops from 13.4 s to 10.6 s at five tokens, and
# a tmpfs mapping measures the same as anonymous RAM during the arithmetic.
: "${K3_TRUNKPATH:=$K3_TRUNK/trunk.bin}"

export K3_MODEL K3_TRUNK K3_TRUNKPATH
