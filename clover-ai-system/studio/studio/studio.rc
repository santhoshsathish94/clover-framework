#include <winver.h>

/* No manifest resource here: mingw-w64 links its default manifest (asInvoker, Windows 10 compatibility). */
1 ICON "clover.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Clover"
      VALUE "FileDescription", "Clover AI Studio"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "CloverAIStudio"
      VALUE "OriginalFilename", "CloverAIStudio.exe"
      VALUE "ProductName", "Clover AI Studio"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
