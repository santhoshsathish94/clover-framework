{
  "manifest_version": 3,
  "name": "Send to Clover",
  "version": "5.0.4",
  "description": "Send the page you are reading to Clover AI Studio on this computer. Nothing is read until you click.",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Send this page to Clover", "default_icon": { "128": "icon.png" } },
  "icons": { "128": "icon.png" }
}
