+pub fn probe(tag: &str) {
+    use std::io::Write;
+    if let Ok(p) = std::env::var("SUPPLY_PROBE") {
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(p) {
+            let line = format!("{} {}
+", std::process::id(), tag);
+            let _ = f.write_all(line.as_bytes());
+        }
+    }
+}
 
