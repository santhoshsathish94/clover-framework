 /// `usable = f > reserve ? f - reserve : 0; slots = (int)(usable / EXPERT_RAW)`; the cast wraps like C's.
 pub fn slots_for(free_bytes: usize, reserve_bytes: usize, expert_raw: usize) -> c_int {
