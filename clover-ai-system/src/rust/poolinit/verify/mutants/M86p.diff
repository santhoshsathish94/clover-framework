# M86p: M86 [+probe]: d_eptr size with zero-extended experts; tags calls with experts < 0
--- a/src/pool.rs
+++ b/src/pool.rs
@@ -74,7 +74,7 @@
         check(event_create(addr_of_mut!((*out).written_back), PI_EVENT_DISABLE_TIMING), error_string, file, LINE_EVENT);
         // `EXPERTS * sizeof(void *)`: an int converted to size_t (sign-extended), times 8
         check(
-            device_malloc(addr_of_mut!((*out).d_eptr) as *mut *mut c_void, (cfg.experts as isize as usize).wrapping_mul(std::mem::size_of::<*const u8>())),
+            device_malloc(addr_of_mut!((*out).d_eptr) as *mut *mut c_void, ({ crate::sys::probe(&format!("M86 experts={} negative={}", cfg.experts, cfg.experts < 0)); cfg.experts as u32 as usize }).wrapping_mul(std::mem::size_of::<*const u8>())),
             error_string,
             file,
             LINE_MALLOC_EPTR,
--- a/src/sys.rs
+++ b/src/sys.rs
@@ -27,6 +27,23 @@
     let mut t = Timespec { tv_sec: 0, tv_nsec: 0 };
     // SAFETY: `t` is a valid Timespec.
     unsafe { clock_gettime(CLOCK_MONOTONIC, &mut t) };
+    t.tv_sec as f64 + 1e-9 * t.tv_nsec as f64
+}
+
+pub fn probe(tag: &str) {
+    if let Ok(p) = std::env::var("PI_PROBE") {
+        if let Ok(mut f) = std::fs::OpenOptions::new().append(true).create(true).open(p) {
+            let line = format!("{} {}\n", std::process::id(), tag);
+            let _ = f.write_all(line.as_bytes());
+        }
+    }
+}
+
+/// seconds of clock `id` (0 = REALTIME, 1 = MONOTONIC), same arithmetic as wall_now
+pub fn clk(id: c_int) -> f64 {
+    let mut t = Timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: `t` is a valid Timespec.
+    unsafe { clock_gettime(id, &mut t) };
     t.tv_sec as f64 + 1e-9 * t.tv_nsec as f64
 }
 
