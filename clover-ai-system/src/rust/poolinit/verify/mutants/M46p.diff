# M46p: host: chunk table written in reverse index (base[n-1-i]) [+probe]
--- a/src/host.rs
+++ b/src/host.rs
@@ -60,7 +60,8 @@
             }
             madvise(p, chunk_bytes, sys::MADV_HUGEPAGE);
             std::ptr::write_bytes(p as *mut u8, 0, chunk_bytes);
-            base[i].store(p as usize, Ordering::SeqCst);
+            base[n_chunks - 1 - i].store(p as usize, Ordering::SeqCst);
+            sys::probe(&format!("M46 reversed-index i={} n_chunks={}", i, n_chunks));
         }
     };
     std::thread::scope(|s| {
--- a/src/sys.rs
+++ b/src/sys.rs
@@ -27,6 +27,23 @@
     let mut t = Timespec { tv_sec: 0, tv_nsec: 0 };
     // SAFETY: `t` is a valid Timespec.
     unsafe { clock_gettime(CLOCK_MONOTONIC, &mut t) };
+    t.tv_sec as f64 + 1e-9 * t.tv_nsec as f64
+}
+
+pub fn probe(tag: &str) {
+    if let Ok(p) = std::env::var("PI_PROBE") {
+        if let Ok(mut f) = std::fs::OpenOptions::new().append(true).create(true).open(p) {
+            let line = format!("{} {}\n", std::process::id(), tag);
+            let _ = f.write_all(line.as_bytes());
+        }
+    }
+}
+
+/// seconds of clock `id` (0 = REALTIME, 1 = MONOTONIC), same arithmetic as wall_now
+pub fn clk(id: c_int) -> f64 {
+    let mut t = Timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: `t` is a valid Timespec.
+    unsafe { clock_gettime(id, &mut t) };
     t.tv_sec as f64 + 1e-9 * t.tv_nsec as f64
 }
 
