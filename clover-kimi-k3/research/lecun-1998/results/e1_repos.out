"""tests for layer forward passes."""

import numpy as np
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from lenet.layers import ConvLayer, SubsampleLayer, FCLayer
import config


def test_subsample_output_shape():
    """6@28x28 input gives 6@14x14. pool 2x2 on 28x28 gives 14x14."""
    layer = SubsampleLayer(n_maps=config.S2_MAPS)
    x = np.random.randn(2, config.S2_MAPS, config.C1_OUTPUT_SIZE, config.C1_OUTPUT_SIZE)
    out = layer.forward(x)
    assert out.shape == (2, config.S2_MAPS, config.S2_OUTPUT_SIZE, config.S2_OUTPUT_SIZE)


def test_fc_output_shape():
    """120-unit input to 84-unit output gives (batch, 84). weight matrix is (84, 120)."""
    layer = FCLayer(in_size=config.C5_UNITS, out_size=config.F6_UNITS)
    x = np.random.randn(4, config.C5_UNITS)
    out = layer.forward(x)
    assert out.shape == (4, config.F6_UNITS)


def test_subsample_gradient():
    """subsample backward gradients match finite differences within 1e-5."""
    np.random.seed(42)
    layer = SubsampleLayer(n_maps=3)
    x = np.random.randn(2, 3, 8, 8)
    out = layer.forward(x)
    dout = np.random.randn(*out.shape)
    dx = layer.backward(dout)
    eps = 1e-5
    numeric = np.zeros_like(x)
    for b in range(x.shape[0]):
        for c in range(x.shape[1]):
            for i in range(x.shape[2]):
                for j in range(x.shape[3]):
                    x[b, c, i, j] += eps
                    out_plus = layer.forward(x)
                    x[b, c, i, j] -= 2 * eps
                    out_minus = layer.forward(x)
                    x[b, c, i, j] += eps
                    numeric[b, c, i, j] = ((out_plus - out_minus) * dout).sum() / (2 * eps)
    diff = np.abs(dx - numeric).max()
    assert diff < 1e-5, f"subsample gradient check failed: max diff = {diff}"


def test_conv_gradient():
    """conv kernel and input gradients match finite differences within 1e-5."""
    np.random.seed(42)
    layer = ConvLayer(2, 3, 3)
    x = np.random.randn(2, 2, 6, 6)
    out = layer.forward(x)
    dout = np.random.randn(*out.shape)
    dx = layer.backward(dout)
    eps = 1e-5

    # check input gradient
    numeric_x = np.zeros_like(x)
    for b in range(x.shape[0]):
        for c in range(x.shape[1]):
            for i in range(x.shape[2]):
                for j in range(x.shape[3]):
                    x[b, c, i, j] += eps
                    out_plus = layer.forward(x)
                    x[b, c, i, j] -= 2 * eps
                    out_minus = layer.forward(x)
                    x[b, c, i, j] += eps
                    numeric_x[b, c, i, j] = ((out_plus - out_minus) * dout).sum() / (2 * eps)
    diff = np.abs(dx - numeric_x).max()
    assert diff < 1e-5, f"conv input gradient check failed: max diff = {diff}"

    # check weight gradient
    numeric_w = np.zeros_like(layer.weights)
    for f in range(layer.weights.shape[0]):
        for c in range(layer.weights.shape[1]):
            for i in range(layer.weights.shape[2]):
                for j in range(layer.weights.shape[3]):
                    layer.weights[f, c, i, j] += eps
                    out_plus = layer.forward(x)
                    layer.weights[f, c, i, j] -= 2 * eps
                    out_minus = layer.forward(x)
                    layer.weights[f, c, i, j] += eps
                    numeric_w[f, c, i, j] = ((out_plus - out_minus) * dout).sum() / (2 * eps)
    diff_w = np.abs(layer.d_weights - numeric_w).max()
--- VTongTV-LeNet-5-scratch/tests/test_loss.py ---
"""tests for loss function gradients."""

import numpy as np
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from lenet.loss import RBFLoss, CrossEntropyLoss
import config


def numerical_gradient(loss_fn, f6_output, labels, eps=1e-5):
    """compute numerical gradient with finite differences."""
    grad = np.zeros_like(f6_output)
    for i in range(f6_output.shape[0]):
        for j in range(f6_output.shape[1]):
            orig = f6_output[i, j]
            f6_output[i, j] = orig + eps
            loss_plus, _ = loss_fn.forward(f6_output, labels)
            f6_output[i, j] = orig - eps
            loss_minus, _ = loss_fn.forward(f6_output, labels)
            f6_output[i, j] = orig
            grad[i, j] = (loss_plus - loss_minus) / (2 * eps)
    return grad


def test_rbf_gradient():
    """rbf loss analytical gradient matches numerical gradient within 1e-5."""
    np.random.seed(42)
    f6_output = np.random.randn(4, config.F6_UNITS)
    labels = np.array([0, 3, 7, 9])
    loss_fn = RBFLoss()
    loss_fn.forward(f6_output.copy(), labels)
    analytic = loss_fn.backward()
    numeric = numerical_gradient(loss_fn, f6_output.copy(), labels)
    diff = np.abs(analytic - numeric).max()
    assert diff < 1e-5, f"rbf gradient check failed: max diff = {diff}"


def test_cross_entropy_gradient():
    """cross-entropy analytical gradient matches numerical within 1e-5."""
    np.random.seed(42)
    f6_output = np.random.randn(4, config.F6_UNITS)
    labels = np.array([0, 3, 7, 9])
    loss_fn = CrossEntropyLoss()
    loss_fn.forward(f6_output.copy(), labels)
    analytic = loss_fn.backward()
    numeric = numerical_gradient(loss_fn, f6_output.copy(), labels)
    diff = np.abs(analytic - numeric).max()
    assert diff < 1e-5, f"cross-entropy gradient check failed: max diff = {diff}"
