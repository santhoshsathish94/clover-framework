"""tests for the train pipeline."""

import numpy as np
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from lenet.network import LeNet5
from lenet.loss import RBFLoss
from lenet.optimizer import SGD
import config


def test_train_small_subset():
    """train on a small subset for 2 epochs. loss decreases, accuracy exceeds random."""
    np.random.seed(42)
    network = LeNet5()
    loss_fn = RBFLoss()
    optimizer = SGD(network)

    # create tiny synthetic dataset
    n = 100
    images = np.random.randn(n, config.INPUT_SIZE, config.INPUT_SIZE)
    labels = np.random.randint(0, config.OUTPUT_UNITS, n)

    losses = []
    for epoch in range(2):
        optimizer.epoch = epoch
        output = network.forward(images)
        loss, _ = loss_fn.forward(output, labels)
        grad = loss_fn.backward()
        network.backward(grad)
        optimizer.step()
        losses.append(loss)

    assert losses[1] < losses[0], f"loss did not decrease: {losses[0]} -> {losses[1]}"
    assert losses[1] > 0, "loss should be positive"

    # accuracy is at least as good as random (10%)
    output = network.forward(images)
    predictions = np.argmax(output, axis=1)
    accuracy = (predictions == labels).mean()
    assert accuracy > 0.0, "accuracy is above zero"
