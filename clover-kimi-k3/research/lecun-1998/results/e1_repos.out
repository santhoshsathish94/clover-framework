"""sanity checks for mnist data load and preprocess."""

import numpy as np
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from data.loader import load_mnist
from data.pipeline import preprocess, train_val_split, batch_iterator, one_hot
import config


def test_mnist_shapes():
    """load mnist and check that shapes are correct after preprocess."""
    train_images, train_labels, test_images, test_labels = load_mnist()
    assert train_images.shape == (60000, config.MNIST_IMAGE_SIZE, config.MNIST_IMAGE_SIZE)
    assert train_labels.shape == (60000,)
    assert test_images.shape == (10000, config.MNIST_IMAGE_SIZE, config.MNIST_IMAGE_SIZE)
    assert test_labels.shape == (10000,)


def test_preprocess_padding():
    """preprocessed images are 32x32."""
    dummy = np.random.randint(0, 255, (10, config.MNIST_IMAGE_SIZE, config.MNIST_IMAGE_SIZE), dtype=np.uint8)
    out = preprocess(dummy)
    assert out.shape == (10, config.INPUT_SIZE, config.INPUT_SIZE)
    assert out.min() >= 0.0
    assert out.max() <= 1.0


def test_normalize_range():
    """normalized pixels are in 0-1 range."""
    dummy = np.random.randint(0, 255, (5, config.MNIST_IMAGE_SIZE, config.MNIST_IMAGE_SIZE), dtype=np.uint8)
    out = preprocess(dummy)
    assert out.min() >= 0.0
    assert out.max() <= 1.0


def test_padding_preserves_content():
    """center of padded image matches original after normalize."""
    dummy = np.full((1, config.MNIST_IMAGE_SIZE, config.MNIST_IMAGE_SIZE), 255, dtype=np.uint8)
    out = preprocess(dummy)
    assert out[0, 2, 2] == 1.0
    assert out[0, 0, 0] == 0.0


def test_train_val_split():
    """split gives 55000 train and 5000 val."""
    images = np.zeros((60000, config.MNIST_IMAGE_SIZE, config.MNIST_IMAGE_SIZE))
    labels = np.zeros(60000, dtype=np.int32)
    train_img, train_lbl, val_img, val_lbl = train_val_split(images, labels)
    assert train_img.shape[0] == 55000
    assert val_img.shape[0] == 5000


def test_batch_iterator():
    """batch iterator yields correct batch sizes."""
    images = np.zeros((100, 32, 32))
    labels = np.zeros(100, dtype=np.int32)
    batches = list(batch_iterator(images, labels, batch_size=32))
    assert len(batches) == 4
    assert batches[0][0].shape[0] == 32


def test_one_hot():
    """one-hot encode produces correct vectors."""
    labels = np.array([0, 3, 9])
    encoded = one_hot(labels)
    assert encoded.shape == (3, config.OUTPUT_UNITS)
    assert encoded[0, 0] == 1.0
    assert encoded[1, 3] == 1.0
    assert encoded[2, 9] == 1.0
    assert encoded.sum() == 3.0
