"""lenet-5 network architecture."""

import numpy as np

import config
from lenet.layers import ConvLayer, SubsampleLayer, FCLayer
from lenet.activations import Tanh
from lenet.connections import get_c3_connections


class LeNet5:
    """lenet-5 network as described in lecun et al. 1998.

    layers: c1, s2, c3, s4, c5, f6, output.
    forward pass calls each in sequence.
    """

    def __init__(self):
        """build all layers in order: c1, s2, c3, s4, c5, f6."""
        self.c1 = ConvLayer(1, config.C1_MAPS, config.KERNEL_SIZE)
        self.tanh_c1 = Tanh()
        self.s2 = SubsampleLayer(config.S2_MAPS)
        self.tanh_s2 = Tanh()
        c3_table = get_c3_connections()
        self.c3 = ConvLayer(config.S2_MAPS, config.C3_MAPS, config.KERNEL_SIZE, connection_table=c3_table)
        self.tanh_c3 = Tanh()
        self.s4 = SubsampleLayer(config.S4_MAPS)
        self.tanh_s4 = Tanh()
        self.c5 = ConvLayer(config.S4_MAPS, config.C5_UNITS, config.KERNEL_SIZE)
        self.tanh_c5 = Tanh()
        self.f6 = FCLayer(config.C5_UNITS, config.F6_UNITS)
        self.tanh_f6 = Tanh()

        self.layers = [
            self.c1, self.tanh_c1,
            self.s2, self.tanh_s2,
            self.c3, self.tanh_c3,
            self.s4, self.tanh_s4,
            self.c5, self.tanh_c5,
            self.f6, self.tanh_f6,
        ]

    def forward(self, x):
        """end-to-end forward pass.

        input goes through c1->s2->c3->s4->c5->f6.
        shapes: 32x32->28x28->14x14->10x10->5x5->120->84.
        matches the paper.
        """
        x = x.reshape(x.shape[0], 1, config.INPUT_SIZE, config.INPUT_SIZE)
        self.flatten_after = {}
        for idx, layer in enumerate(self.layers):
            x = layer.forward(x)
            if hasattr(x, 'shape') and len(x.shape) == 4 and x.shape[2] == 1 and x.shape[3] == 1:
                self.flatten_after[idx] = x.shape
                x = x.reshape(x.shape[0], -1)
        return x

    def backward(self, dout):
        """end-to-end backward pass. calls backward on each layer in reverse.

        passes gradient from one layer to the next. stores all weight
        and bias gradients on each layer object. unflattens when needed.
        """
        for idx in range(len(self.layers) - 1, -1, -1):
            if idx in self.flatten_after:
                orig_shape = self.flatten_after[idx]
                dout = dout.reshape(orig_shape)
            dout = self.layers[idx].backward(dout)
        return dout

    def reinitialize_weights(self):
        """reset all weights per the paper's scheme.

        weights drawn from uniform(-2.4/fan_in, 2.4/fan_in).
        biases set to zero. fan_in is the number of inputs to a unit.
        """
        self.__init__()
--- VTongTV-LeNet-5-scratch/lenet/optimizer.py ---
"""sgd optimizer with momentum and staged learning rate decay."""

import numpy as np

import config


class SGD:
    """stochastic gradient descent with momentum and the paper's lr schedule.

    the paper uses: dw(t) = momentum * dw(t-1) - lr * grad
    lr schedule: 0.0005 for first 2 passes, 0.0002 for next 3,
    0.0001 for next 3, 0.00005 for rest.
    """

    def __init__(self, network, momentum=0.9):
        """initialize velocity buffers for each layer."""
        self.network = network
        self.epoch = 0
        self.momentum = momentum
        self.schedule = config.LR_SCHEDULE
        self.velocities = {}
        for name in ['c1', 's2', 'c3', 's4', 'c5', 'f6']:
            layer = getattr(network, name)
            self.velocities[(name, 'w')] = np.zeros_like(layer.weights)
            self.velocities[(name, 'b')] = np.zeros_like(layer.bias)

    def get_lr(self):
        """return the learning rate for the current epoch."""
        cumulative = 0
        for num_epochs, lr in self.schedule:
            cumulative += num_epochs
            if self.epoch < cumulative:
                return lr
        return self.schedule[-1][1]

    def step(self):
        """update all weights and biases with sgd and momentum.

        dw(t) = momentum * dw(t-1) - lr * grad
        w += dw(t)
        """
        lr = self.get_lr()
        for name in ['c1', 's2', 'c3', 's4', 'c5', 'f6']:
            layer = getattr(self.network, name)
            if layer.d_weights is not None:
                vw = self.velocities[(name, 'w')]
                vw[:] = self.momentum * vw - lr * layer.d_weights
                layer.weights += vw
            if layer.d_bias is not None:
                vb = self.velocities[(name, 'b')]
                vb[:] = self.momentum * vb - lr * layer.d_bias
                layer.bias += vb
