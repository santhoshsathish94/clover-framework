"""tests for the lenet-5 network."""

import numpy as np
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from lenet.network import LeNet5
import config


def test_output_shape_each_layer():
    """feeds random 32x32 input and checks shape after each layer."""
    net = LeNet5()
    x = np.random.randn(2, 32, 32)
    x = x.reshape(2, 1, config.INPUT_SIZE, config.INPUT_SIZE)

    x = net.c1.forward(x)
    assert x.shape == (2, config.C1_MAPS, config.C1_OUTPUT_SIZE, config.C1_OUTPUT_SIZE)
    x = net.tanh_c1.forward(x)
    assert x.shape == (2, config.C1_MAPS, config.C1_OUTPUT_SIZE, config.C1_OUTPUT_SIZE)

    x = net.s2.forward(x)
    assert x.shape == (2, config.S2_MAPS, config.S2_OUTPUT_SIZE, config.S2_OUTPUT_SIZE)
    x = net.tanh_s2.forward(x)
    assert x.shape == (2, config.S2_MAPS, config.S2_OUTPUT_SIZE, config.S2_OUTPUT_SIZE)

    x = net.c3.forward(x)
    assert x.shape == (2, config.C3_MAPS, config.C3_OUTPUT_SIZE, config.C3_OUTPUT_SIZE)
    x = net.tanh_c3.forward(x)
    assert x.shape == (2, config.C3_MAPS, config.C3_OUTPUT_SIZE, config.C3_OUTPUT_SIZE)

    x = net.s4.forward(x)
    assert x.shape == (2, config.S4_MAPS, config.S4_OUTPUT_SIZE, config.S4_OUTPUT_SIZE)
    x = net.tanh_s4.forward(x)
    assert x.shape == (2, config.S4_MAPS, config.S4_OUTPUT_SIZE, config.S4_OUTPUT_SIZE)

    x = net.c5.forward(x)
    assert x.shape == (2, config.C5_UNITS, 1, 1)
    x = net.tanh_c5.forward(x)
    assert x.shape == (2, config.C5_UNITS, 1, 1)
    x = x.reshape(2, -1)

    x = net.f6.forward(x)
    assert x.shape == (2, config.F6_UNITS)
    x = net.tanh_f6.forward(x)
    assert x.shape == (2, config.F6_UNITS)


def test_forward_pass_random_input():
    """end-to-end forward pass produces (batch, 84) output. no crashes, no nans."""
    net = LeNet5()
    x = np.random.randn(4, 32, 32)
    out = net.forward(x)
    assert out.shape == (4, config.F6_UNITS)
    assert np.all(np.isfinite(out))


def test_backward_pass():
    """runs forward then backward on a small batch. checks gradients exist, are finite, and have right shapes."""
    np.random.seed(42)
    net = LeNet5()
    x = np.random.randn(2, 32, 32)
    out = net.forward(x)
    dout = np.random.randn(*out.shape)
    dx = net.backward(dout)
    assert dx is not None
    assert np.all(np.isfinite(dx))
    assert dx.shape == (2, 1, config.INPUT_SIZE, config.INPUT_SIZE)
    for layer in net.layers:
        if hasattr(layer, 'd_weights') and layer.d_weights is not None:
            assert np.all(np.isfinite(layer.d_weights))
        if hasattr(layer, 'd_bias') and layer.d_bias is not None:
            assert np.all(np.isfinite(layer.d_bias))
