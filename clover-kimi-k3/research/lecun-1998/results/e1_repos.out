--- VTongTV-LeNet-5-scratch/utils/tensor_ops.py ---
"""tensor operation utilities for efficient convolution."""

import numpy as np


def im2col(x, kh, kw, stride=1):
    """extract overlapping patches from x and stack as columns.

    turns a convolution into a matrix multiply.
    x shape: (batch, channels, height, width).
    returns shape: (batch, channels * kh * kw, out_h * out_w).
    """
    n, c, h, w = x.shape
    out_h = (h - kh) // stride + 1
    out_w = (w - kw) // stride + 1
    cols = np.zeros((n, c, kh, kw, out_h, out_w))
    for i in range(kh):
        i_max = i + stride * out_h
        for j in range(kw):
            j_max = j + stride * out_w
            cols[:, :, i, j, :, :] = x[:, :, i:i_max:stride, j:j_max:stride]
    cols = cols.reshape(n, c * kh * kw, out_h * out_w)
    return cols


def col2im(cols, x_shape, kh, kw, stride=1):
    """reverse of im2col. accumulates values back into the original shape.

    use for backprop through conv layers.
    cols shape: (batch, channels * kh * kw, out_h * out_w).
    returns shape: (batch, channels, height, width).
    """
    n, c, h, w = x_shape
    out_h = (h - kh) // stride + 1
    out_w = (w - kw) // stride + 1
    cols = cols.reshape(n, c, kh, kw, out_h, out_w)
    x = np.zeros(x_shape)
    for i in range(kh):
        i_max = i + stride * out_h
        for j in range(kw):
            j_max = j + stride * out_w
            x[:, :, i:i_max:stride, j:j_max:stride] += cols[:, :, i, j, :, :]
    return x
