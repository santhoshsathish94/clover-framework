"""train loop for lenet-5."""

import logging
import numpy as np

import config
from lenet.network import LeNet5
from lenet.optimizer import SGD
from lenet.loss import RBFLoss
from data.loader import load_mnist
from data.pipeline import preprocess, train_val_split, batch_iterator, one_hot, distort_batch

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


def train(network=None, epochs=20, loss_fn=None):
    """train lenet-5 on mnist.

    iterates over epochs. each epoch: forward pass, loss, backward
    pass, sgd update. logs loss every 100 batches.
    """
    if network is None:
        network = LeNet5()
    if loss_fn is None:
        loss_fn = RBFLoss()

    optimizer = SGD(network)
    train_images, train_labels, test_images, test_labels = load_mnist()
    train_images = preprocess(train_images)
    test_images = preprocess(test_images)
    train_img, train_lbl, val_img, val_lbl = train_val_split(train_images, train_labels)

    for epoch in range(epochs):
        optimizer.epoch = epoch
        epoch_loss = 0.0
        n_batches = 0
        for batch_img, batch_lbl in batch_iterator(train_img, train_lbl):
            batch_img_28 = batch_img[:, 2:30, 2:30]  # undo padding for distortion
            batch_img_dist = distort_batch(batch_img_28)
            batch_img_padded = np.zeros((batch_img_dist.shape[0], config.INPUT_SIZE, config.INPUT_SIZE))
            batch_img_padded[:, 2:30, 2:30] = batch_img_dist
            batch_img = batch_img_padded

            output = network.forward(batch_img)
            loss, rbf_out = loss_fn.forward(output, batch_lbl)
            grad = loss_fn.backward()
            network.backward(grad)
            optimizer.step()

            epoch_loss += loss
            n_batches += 1
            if n_batches % 100 == 0:
                logger.info(f"epoch {epoch+1} batch {n_batches} loss: {loss:.4f}")

        avg_loss = epoch_loss / n_batches
        logger.info(f"epoch {epoch+1} done. avg loss: {avg_loss:.4f} lr: {optimizer.get_lr()}")

    return network


if __name__ == "__main__":
    network = LeNet5()
    network = train(network, epochs=20)
    train_images, train_labels, test_images, test_labels = load_mnist()
    test_images = preprocess(test_images)
    from evaluate import evaluate, log_evaluation, most_confused_pairs
    accuracy, confusion = evaluate(network, test_images, test_labels)
    log_evaluation(accuracy, confusion)
    most_confused_pairs(confusion)
