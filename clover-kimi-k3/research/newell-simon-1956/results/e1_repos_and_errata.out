=== 2. Diff orig-logic-routines.txt vs logic-routines.txt (1956 P-868 Section III errata) ===
--- orig-logic-routines.txt	2026-10-26 10:03:29.642290156 +0100
+++ logic-routines.txt	2026-10-26 10:03:29.642290156 +0100
@@ -10,24 +10,34 @@
 # July 12, 1956
 # Revised
 #
-# Meant to be as in the report, except for reformatting
-# (I added dashes to fill blank columns and put colons
-# after the labels.)
-# This transcription only contains the labels, operation
-# codes and operands.  Comments and the column labeled
-# "Seg." have not been transcribed.
-#
-# There are some typos and bugs which were present in
-# the original report.
+# I reformatted the code by adding dashes to fill blank
+# columns and putting colons after the labels.  I then
+# made obvious repairs, fixing obvious typos, correcting
+# "-TSb" to "TF", and changing the parenthesized descriptions
+# in Ex to new opcodes.  Also, some additional fixes were made,
+# as described below, and new opcodes were introduced in order
+# to print the proof steps found by the program.
 #
 
 #
 # Executive (top) routine (p. 50)
 #
+# The first two and last five steps
+# were not assigned opcodes in the paper, but were described
+# by words in parentheses.
+#
+# There was an obvious problem here, since -FEN P 2
+# was called before 2 was loaded.  To fix this,
+# the instruction "PE 1 2" was inserted before
+# "-FEN P 2".
+#
+# A test was added before "-MSb 1 - - G" to see
+# if the expression to prove was blank.
 #
 ! Ex
-    (Read problem X)
-    (Put EM(X) in 1)
+    READ_PROBLEM
+    PUT_MAIN_INTO_1
+    TB   1 - - H
    -MSb  1 - - G
 A: -MDt  1 - - G
    -MCh  1 - - G
@@ -35,6 +45,7 @@
     CWG  - - - H
 B:  FEF  P 1 - H
     NK   1
+    PE   1 2
 C: -FEN  P 2 - D
     NK   2
     CKG  2 1 - C
@@ -48,17 +59,29 @@
     FEN  Q 3 - E
 F:  B    - - - A
 
-G:  (Write proof.)
-    (X(1) a theorem)
-    (Stop)
+G:  WRITE_PROOF
+    STORE_1_AS_THEOREM
+    STOP
 
-H:  (Write:no proof)
-    (Stop)
+H:  WRITE_NO_PROOF
+    STOP
 !
 
 # Chaining method (p. 51)
 # If can't prove X(x) by chaining, -> b;
 # Store new problems in P.
+
+#
+# This routine was rewritten and
+# reorganized somewhat in order to
+# facilitate printing the output
+# proof, avoid problems coming from stale
+# data not matching the expressions
+# in storage being present in the
+# working memories and avoid possible problems
+# coming from free variables being introduced
+# into the problem being solved.
+#
 ! MCh
    -TC-> L - - D
     VV   L
@@ -69,34 +92,60 @@
     VV   3
     SX   3 4
     FL   4 5
-    FR   4 6
    -CSm  1 5 - B
    -LMc  5 1 - E
-B: -CSm  2 6 - C
+B:  FR   4 6
+   -CSm  2 6 - C
    -LMc  6 2 - F
 C:  FEN  T 3 - A
 D:  BHB
 
-E:  PE   2 5
-    PE   6 1
-   -LMc  1 5 - G
+E:  FR   4 6
+   -LMc  6 2 - G
+    AM   7
+    PC-> 7
+    S    7
+    SEN  7 P
+    SXR  2 7
+    FR   4 6
+    SXL  6 7
+    PROOF_FWD L 3 7
+    MSb  7 - - C
+    BHN
+
+
 F:  AM   7
     PC-> 7
     S    7
     SEN  7 P
     SXL  1 7
+    FL   4 5
     SXR  5 7
+    PROOF_BACK L 3 7
     MSb  7 - - C
-G:  BHN
+    BHN
+G:  PROOF_SUB L 3
+    BHN
 !
 
 # Detachment method (p. 52)
 # If can't prove X(x) by detachment, -> b.
 # Store new problems in P.
 
+#
+# There is a problem here when copying the new
+# subproblem from working memory 5 to
+# working memory 6: although SXM copies
+# the address of a new storage location into working
+# memory 6, it does not load the main element of
+# this location into the memory.  This causes
+# problems when calling MSb.  To fix this, the
+# instruction "FM 6 6" was put in place of
+# the instruction "S 6".
+#
 ! MDt
     FEF  T 1 - C
-A:  TC-> 1 - - B
+A: -TC-> 1 - - B
     VV   1
     FR   1 2
     VV   L
@@ -111,8 +160,9 @@
     LMc  4 L - B
     FL   3 5
     SXM  5 6
-    S    6
+    FM   6 6
     SEN  6 P
+    PROOF_DET L 1 6
     MSb  6 - - B
     BHN
 !
@@ -120,6 +170,21 @@
 # Substitution method (p. 52)
 # If can't prove X(x) by substitution, -> b.
 
+# The instructions in the report say "LMc 2 L",
+# but the program logic means that "- B" should
+# be added.  Also, the label "D" was missing.
+
+#
+# There was a problem here, because although
+# SX makes a copy of the expression pointed
+# to by working memory 1 in working memory
+# 2, it does not load the main element of
+# this copy into working memory 2.
+# This causes LMc to fail.
+# To fix this, the instruction "FM 2 2"
+# was inserted after "SX 1 2".
+#
+
 ! MSb
     NAW
     VV   L
@@ -129,13 +194,20 @@
 B:  FEN  T 1 - A
 C:  BHB
 
-    SX   1 2
-    LMc  2 L
+D:  SX   1 2
+    FM   2 2
+    LMc  2 L - B
+    PROOF_SUB L 1
     BHN
 
 # Matching routine (p. 53)
 # Match X(x) to X(y); if can't, -> b
 
+#
+# "NAGG L C" was added before the second "BHN",
+# in order to not change the value of C.
+#
+
 ! LMc
     CGG    C L - A
     CGG    L C - C
@@ -150,14 +222,15 @@
     LMc    3 4 - H
     BHN
 
-A:  TV     L - - H
+A: -TV     L - - H
    -TF     L - - H
 B:  NSGG   L C
     FM     L 5
     LSb    C L 5
+    NAGG   L C
     BHN
 
-C:  TV     C - - H
+C: -TV     C - - H
 D: -TF     C - - H
     NSGG   C L
     FM     C 5
@@ -180,6 +253,16 @@
 # Substitution routine (p. 54)
 # Substitute X(x) for E(y) (=V) in X(z) (=M).
 
+#
+# There was a problem here since it may be that LSb
+# is called to substitute a variable with an
+# expression containing that variable, possibly
+# causing it to try to grow an infinite expression.
+# To prevent this, a freeness check, "-TF 2 - - E",
+# was added after "-CN 2 C", and all subproblem
+# variables were marked non-free upon copying
+# by SXM, SXL and SXR.
+#
 ! LSb
     FEF  L 1 - F
 A:  CPS  1 1 - B
@@ -187,6 +270,7 @@
 B:  FEN  L 1 - A
 C:  FEF  R 2 - F
 D: -CN   2 C - E
+   -TF   2 - - E
     PE   L 3
     NAGG 2 3
     SXE  3 2
@@ -225,7 +309,7 @@
     FL   L 1
     TGG  1 - - C
    -TV   1 - - A
-   -TSb  1 - - B
+    TF   1 - - B
 A:  BHB
 
 B:  PE   1 2
@@ -338,12 +422,16 @@
 !
 
 # Describe (p. 58)
-# The "x" after "BHN" is missing in the IRE Transactions version.
+#
+# There was originally a "x" after "BHN", except in
+# the IRE Transactions version, and also
+# nonsensical "x"s after NH, NJ, and NK.
+#
 ! D
-    NK  x
-    NJ  x
-    NH  x
-    BHN x
+    NK  L
+    NJ  L
+    NH  L
+    BHN
 !
 
 # Count levels (p. 58)
@@ -377,7 +465,7 @@
     FEN 1 3 - B
 C:  SEN 2 1
     NAJ L
-    FEN L 2 - A
+D:  FEN L 2 - A
 E:  BHN
 !
 
@@ -411,11 +499,19 @@
 # Store X(x) at (new) A(y) as main expression
 # (p. 60)
 
+# Since this routine is used only to copy
+# new subproblems into the subproblem list,
+# "PFB 2" was inserted to make the variables
+# of the copied expression non-free, in order
+# to prevent looping in LSb.  See the comments
+# there.
+
 ! SXM
     AA   C
     FEF  L 1 - C
-A:  CPS  1 L - B
+A: -CPS  1 L - B
     PE   1 2
+    PFB  2
     PM   C 2
     HSPP L 2
     S    2
@@ -430,7 +526,7 @@
 ! SXE
     FEF  L 1 - D
 A:  CP   L 1 - E
-    CPS  1 L - C
+   -CPS  1 L - C
     PE   1 2
 B:  PM   C 2
     HSPP L 2
@@ -446,10 +542,18 @@
 # Store X(x) in A(y) as XL(y) (p. 61)
 # SXL x y
 
+# Since this routine is used only to copy
+# new subproblems into the subproblem list,
+# "PFB 2" was inserted to make the variables
+# of the copied expression non-free, in order
+# to prevent looping in LSb.  See the comments
+# there.
+
 ! SXL
     FEF  L 1 - C
-A:  CPS  1 L - B
+A: -CPS  1 L - B
     PE   1 2
+    PFB  2
     PM   C 2
     HSPP L 2
     HAPL 2
@@ -470,10 +574,18 @@
 # report, the labels are missing and also
 # the "A" at the end of "FEN L 1 - A".
 
+# Since this routine is used only to copy
+# new subproblems into the subproblem list,
+# "PFB 2" was inserted to make the variables
+# of the copied expression non-free, in order
+# to prevent looping in LSb.  See the comments
+# there.
+
 ! SXR
     FEF  L 1 - C
-A:  CPS  1 L - B
+A: -CPS  1 L - B
     PE   1 2
+    PFB  2
     PM   C 2
     HSPP L 2
     HAPR 2
