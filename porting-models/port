#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
if [ -x "/venv/main/bin/python3" ]; then
    PYTHON_BIN="/venv/main/bin/python3"
elif [ -x "/dev/shm/clover-port/venv/bin/python" ]; then
    PYTHON_BIN="/dev/shm/clover-port/venv/bin/python"
elif [ -x "/root/ncm-cpu/venv/bin/python" ]; then
    PYTHON_BIN="/root/ncm-cpu/venv/bin/python"
fi
export HF_HOME="${HF_HOME:-/dev/shm/clover-port/hf-cache}"
exec "$PYTHON_BIN" "$SCRIPT_DIR/port_model.py" "$@"
